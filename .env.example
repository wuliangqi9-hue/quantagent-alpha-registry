# Runtime API environment.
# Put these in the root .env for local API runs, or in your public hosting
# provider's environment variable settings for deployment.

# Mantle Sepolia (optional; enables real on-chain recording)
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003
MANTLE_EXPLORER_BASE=https://explorer.sepolia.mantle.xyz
MANTLE_PRIVATE_KEY=
SIGNAL_REGISTRY_ADDRESS=

# Frontend (optional; split web/API deployment only)
# Leave unset when the built frontend is served by the FastAPI app.
# Set this only when deploying the web app separately from the API.
# Development example only; do not use localhost in the final submitted build.
VITE_API_URL=http://127.0.0.1:8000
