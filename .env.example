# =============================================================================
# QuantAgent Alpha Registry — Environment Template
# =============================================================================
# Copy this file to .env (root) and fill in your values.
# NEVER commit .env or any file containing real secrets.
# =============================================================================

# ---- Mantle Network --------------------------------------------------------
# Mantle Sepolia for development. Switch to Mantle Mainnet before final
# judged live submission if the hackathon track requires mainnet benchmarking.
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003
MANTLE_EXPLORER_BASE=https://explorer.sepolia.mantle.xyz
MANTLE_PRIVATE_KEY=

# Optional: protected/private RPC endpoint. When set, the API uses this endpoint
# for transaction broadcasts instead of the public MANTLE_RPC_URL.
PRIVATE_MEMPOOL_RPC_URL=

# ---- On-Chain Registries ---------------------------------------------------
# Project-deployed SignalRegistry (own contract, deployed from contracts/)
SIGNAL_REGISTRY_ADDRESS=

# Project-deployed zkTLS proof gate (own contract, deployed from contracts/)
QUANT_AGENT_EXECUTOR_ADDRESS=

# Official ERC-8004 external registries (read-only from our perspective).
# These addresses are example defaults; update to match the deployed official
# registry addresses on your target network.
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ---- Agent Identity (ERC-8004-inspired) ------------------------------------
# 1. Deploy SignalRegistry.
# 2. POST /api/agent/register with AGENT_URI, then read the Registered event.
# 3. Set AGENT_ID and VALIDATOR_ADDRESS before final signal recording.
AGENT_ID=
AGENT_URI=https://example.com/quantagent-alpha-registry/agent.json
VALIDATOR_ADDRESS=
PROOF_URI_BASE=ipfs://quantagent-demo-proof

# ---- ATLAS OPRO Prompt Registry --------------------------------------------
# Path to the JSONL file storing prompt variants and settlement outcomes.
# Defaults to data/atlas_opro.jsonl if unset.
ATLAS_OPRO_STORE_PATH=

# ---- x402 Micropayment Pipeline --------------------------------------------
# Blocky402 facilitator endpoint. When set, x402 payment intents can be
# submitted to the facilitator for on-chain settlement.
BLOCKY402_FACILITATOR_URL=
X402_WALLET_ADDRESS=
X402_MAX_AUTO_PAY_USD=0.25

# ---- Byreal / RealClaw Adapter ---------------------------------------------
# Current status: adapter / simulation-ready.
# When real SDK credentials are configured, the adapter can switch to live
# RFQ execution-intent routing.
BYREAL_API_BASE=
BYREAL_API_KEY=
BYREAL_SIMULATION_MODE=true

# ---- Reclaim zkTLS (reserved / future) -------------------------------------
# QuantAgentExecutor uses a Reclaim-compatible IReclaim.verifyProof interface
# (minimal local interface, NOT the official SDK import). These variables are
# reserved for future full SDK integration. Code does NOT currently read them.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_VERIFIER_ADDRESS=

# ---- Frontend (optional; split web/API deployment only) --------------------
# Leave unset when the built frontend is served by the FastAPI app.
# Set this only when deploying the web app separately from the API.
# Development example only; do not use localhost in the final submitted build.
VITE_API_URL=http://127.0.0.1:8000