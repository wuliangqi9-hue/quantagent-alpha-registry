# Runtime API environment.
# Put these in the root .env for local API runs, or in your public hosting
# provider's environment variable settings for deployment.

# Mantle Sepolia for development. Switch these to Mantle Mainnet before final
# judged live submission if the hackathon track requires mainnet benchmarking.
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003
MANTLE_EXPLORER_BASE=https://explorer.sepolia.mantle.xyz
MANTLE_PRIVATE_KEY=
SIGNAL_REGISTRY_ADDRESS=

# Optional: protected/private RPC endpoint. When set, the API uses this endpoint
# for transaction broadcasts instead of the public MANTLE_RPC_URL.
PRIVATE_MEMPOOL_RPC_URL=

# ERC-8004-inspired agent configuration.
# 1. Deploy SignalRegistry.
# 2. POST /api/agent/register with AGENT_URI, then read the Registered event.
# 3. Set AGENT_ID and VALIDATOR_ADDRESS before final signal recording.
AGENT_ID=
AGENT_URI=https://example.com/quantagent-alpha-registry/agent.json
VALIDATOR_ADDRESS=
PROOF_URI_BASE=ipfs://quantagent-demo-proof

# Optional Byreal / RealClaw adapter settings.
BYREAL_API_BASE=
BYREAL_API_KEY=
BYREAL_SIMULATION_MODE=true

# Frontend (optional; split web/API deployment only)
# Leave unset when the built frontend is served by the FastAPI app.
# Set this only when deploying the web app separately from the API.
# Development example only; do not use localhost in the final submitted build.
VITE_API_URL=http://127.0.0.1:8000
